  publisher  = {Association for Computing Machinery},
  author     = {Rak-amnouykit, Ingkarat and McCrevan, Daniel and Milanova, Ana and Hirzel, Martin and Dolby, Julian},
  month      = nov,
  year       = {2020},
  pages      = {57--70},
  file       = {Full Text PDF:/Users/vo21765/Zotero/storage/E6AN8WNM/Rak-amnouykit et al. - 2020 - Python 3 types in the wild a tale of two type systems.pdf:application/pdf}
}