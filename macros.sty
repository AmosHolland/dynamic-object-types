\newcommand{\num}[1]{\underline{\mathsf{#1}}}
\newcommand{\true}{\mathsf{true}}
\newcommand{\false}{\mathsf{false}}
\newcommand{\listExp}[1]{\mathsf{[}#1\mathsf{]}}
\newcommand{\dictExp}[1]{\mathsf{\{}#1\mathsf{\}}}
\newcommand{\newExp}{\mathsf{new}}

\newcommand{\funDecl}[4]{\mathsf{def \,#1(} #2 \mathsf{):}\, #3 \mathsf{in} \,#4}
\newcommand{\varDecl}[3]{#1 := #2 \,\mathsf{in}\, #3}

\newcommand{\ifStmt}[3]{\mathsf{if}\, #1 \,\mathsf{:}\, #2\, \mathsf{else:}\, #3}
\newcommand{\returnStmt}{\mathsf{return}\,}

\newcommand{\intty}{\mathsf{int}}
\newcommand{\boolty}{\mathsf{bool}}
\newcommand{\objty}[1]{\mathsf{o_#1}}
\newcommand{\listty}{\mathsf{List}}
\newcommand{\dictty}{\mathsf{Dict}}
\newcommand{\anyty}{\mathsf{Any}}
\newcommand{\nonety}{\mathsf{None}}

\newcommand{\types}{\vdash}
\newcommand{\with}{\,\&\,}
